# Copy to evaluation/.env.local (ignored by Git), then add authorized Groq keys.
# GROQ_EVAL_KEY_1=gsk_your_authorized_key
# GROQ_EVAL_KEY_1_ENABLED=true
# GROQ_EVAL_KEY_2=gsk_another_authorized_key
# GROQ_EVAL_KEY_2_ENABLED=false
# If GROQ_EVAL_KEY_n entries are absent, GROQ_API_KEY is used as KEY_1.
